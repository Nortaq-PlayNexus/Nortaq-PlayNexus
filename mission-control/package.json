{
  "name": "nortaq-mission-control",
  "description": "Live observability platform for the Nortaq-PlayNexus ecosystem",
  "author": "Nortaq-PlayNexus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/copy-data.mjs",
    "build:electron": "set VITE_BASE=./&& npm run build",
    "preview": "vite preview",
    "electron:dev": "electron .",
    "electron:build": "npm run build:electron && electron-builder",
    "collect": "python scripts/collect-data.py"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.nortaq.missioncontrol",
    "productName": "NORTAQ Mission Control",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
